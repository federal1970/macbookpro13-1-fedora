+/******************************************************************************
+ *                      Apple MacBookPro13,1 Specific Arrays
+ *                   CS8409 / CS42L83 / 4 x SSM3515 on ASP1
+ ******************************************************************************/
+
+/*
+ * The amps take their only clock from the ASP1 bit clock, and the clock setup
+ * below is the one AppleHDA uses: a 256 bit frame at 44.1 kHz.
+ */
+const struct hda_pcm_stream mbp131_44k_pcm_analog_playback = {
+	.rates = SNDRV_PCM_RATE_44100, /* fixed rate */
+};
+
+const struct hda_pcm_stream mbp131_44k_pcm_analog_capture = {
+	.rates = SNDRV_PCM_RATE_44100, /* fixed rate */
+};
+
+const struct hda_verb mbp131_init_verbs[] = {
+	{ CS8409_PIN_AFG, AC_VERB_SET_GPIO_WAKE_MASK, 0x0001 },		/* WAKE from GPIO 0 */
+	{ CS8409_PIN_VENDOR_WIDGET, AC_VERB_SET_PROC_STATE, 0x0001 },	/* Enable VPW processing */
+	{ CS8409_PIN_VENDOR_WIDGET, AC_VERB_SET_COEF_INDEX, 0x0002 },	/* Configure GPIO 6,7 */
+	/* I2C mode, and the bus idle setting mbp131_hw_cfg ends with */
+	{ CS8409_PIN_VENDOR_WIDGET, AC_VERB_SET_PROC_COEF,  0x0280 },
+	{ CS8409_PIN_VENDOR_WIDGET, AC_VERB_SET_COEF_INDEX, 0x005b },	/* I2C control */
+	{ CS8409_PIN_VENDOR_WIDGET, AC_VERB_SET_PROC_COEF,  0x0010 },	/* as AppleHDA sets it */
+	{} /* terminator */
+};
+
+/*
+ * The firmware programs these at boot, but they are not there any more,
+ * together with the subsystem ID, once the controller has been probed again.
+ */
+static const struct hda_pintbl mbp131_pincfgs[] = {
+	{ CS8409_PIN_ASP1_TRANSMITTER_A, 0x90100110 },	/* ASP-1-TX A, speakers */
+	{ CS8409_PIN_ASP1_TRANSMITTER_B, 0x90100111 },	/* ASP-1-TX B, speakers */
+	{ CS8409_PIN_ASP2_TRANSMITTER_A, 0x002b4020 },	/* ASP-2-TX, headphone jack */
+	{ CS8409_PIN_ASP2_RECEIVER_A, 0x00ab9030 },	/* ASP-2-RX, headset mic */
+	{ CS8409_PIN_DMIC1_IN, 0xa0a60100 },		/* DMIC-1, internal mic */
+	{} /* terminator */
+};
+
+/*
+ * Vendor specific HW configuration for CS8409/CS42L83/SSM3515. PLL2 stays on:
+ * AppleHDA leaves it running from the first use of ASP2.
+ */
+const struct cs8409_cir_param mbp131_hw_cfg[] = {
+	/* +PLL1/2_EN, +I2C_EN */
+	{ CS8409_PIN_VENDOR_WIDGET, CS8409_DEV_CFG1, 0xb008 },
+	/* ASP1/2_EN=0 */
+	{ CS8409_PIN_VENDOR_WIDGET, CS8409_DEV_CFG2, 0x0200 },
+	/* ASP1.A: TX.LAP=0, TX.LSZ=24 bits, TX.LCS=0 */
+	{ CS8409_PIN_VENDOR_WIDGET, ASP1_A_TX_CTRL1, 0x0800 },
+	/* ASP1.A: TX.RAP=0, TX.RSZ=24 bits, TX.RCS=32 */
+	{ CS8409_PIN_VENDOR_WIDGET, ASP1_A_TX_CTRL2, 0x0820 },
+	/* ASP1.B: TX.LAP=0, TX.LSZ=24 bits, TX.LCS=64 */
+	{ CS8409_PIN_VENDOR_WIDGET, ASP1_B_TX_CTRL1, 0x0840 },
+	/* ASP1.B: TX.RAP=0, TX.RSZ=24 bits, TX.RCS=96 */
+	{ CS8409_PIN_VENDOR_WIDGET, ASP1_B_TX_CTRL2, 0x0860 },
+	/* ASP1: LCHI = 00h */
+	{ CS8409_PIN_VENDOR_WIDGET, CS8409_ASP1_CLK_CTRL1, 0x8000 },
+	/* ASP1: LCPR = FFh, 256 bit clocks per frame */
+	{ CS8409_PIN_VENDOR_WIDGET, CS8409_ASP1_CLK_CTRL2, 0x08ff },
+	/* ASP1: MCEN=0, FSD=000, SCPOL_IN/OUT=0, SCDIV=001 */
+	{ CS8409_PIN_VENDOR_WIDGET, CS8409_ASP1_CLK_CTRL3, 0x0001 },
+	/* ASP1.A and ASP1.B in one sync group */
+	{ CS8409_PIN_VENDOR_WIDGET, ASP1_SYNC_CTRL, 0x0003 },
+	/* ASP2.A: TX.LAP=0, TX.LSZ=24 bits, TX.LCS=0 */
+	{ CS8409_PIN_VENDOR_WIDGET, ASP2_A_TX_CTRL1, 0x0800 },
+	/* ASP2.A: TX.RAP=0, TX.RSZ=24 bits, TX.RCS=32 */
+	{ CS8409_PIN_VENDOR_WIDGET, ASP2_A_TX_CTRL2, 0x0820 },
+	/* ASP2.A: RX.LAP=0, RX.LSZ=24 bits, RX.LCS=0 */
+	{ CS8409_PIN_VENDOR_WIDGET, ASP2_A_RX_CTRL1, 0x0800 },
+	/* ASP2.A: RX.RAP=0, RX.RSZ=24 bits, RX.RCS=32 */
+	{ CS8409_PIN_VENDOR_WIDGET, ASP2_A_RX_CTRL2, 0x0820 },
+	/* ASP2 sample rate tracking for 44.1 kHz, as AppleHDA */
+	{ CS8409_PIN_VENDOR_WIDGET, ASP2_Tx_RATE1, 0xaaaa },
+	{ CS8409_PIN_VENDOR_WIDGET, ASP2_Tx_NULL_INS_RMV, 0x0100 },
+	{ CS8409_PIN_VENDOR_WIDGET, ASP2_Rx_RATE1, 0xaccc },
+	{ CS8409_PIN_VENDOR_WIDGET, ASP2_Rx_NULL_INS_RMV, 0x0001 },
+	/* ASP2: LCHI = 00h */
+	{ CS8409_PIN_VENDOR_WIDGET, CS8409_ASP2_CLK_CTRL1, 0x8000 },
+	/* ASP2: LCPR = FFh, 256 bit clocks per frame */
+	{ CS8409_PIN_VENDOR_WIDGET, CS8409_ASP2_CLK_CTRL2, 0x10ff },
+	/* ASP2: MCEN=0, FSD=010, SCPOL_IN/OUT=0, SCDIV=010 */
+	{ CS8409_PIN_VENDOR_WIDGET, CS8409_ASP2_CLK_CTRL3, 0x0042 },
+	/* DMIC1_MO=10b, DMIC1/2_SR=1 */
+	{ CS8409_PIN_VENDOR_WIDGET, CS8409_DMIC_CFG, 0x0033 },
+	/* ASP1/2_BEEP=0 */
+	{ CS8409_PIN_VENDOR_WIDGET, CS8409_BEEP_CFG, 0x0000 },
+	/* ASP1/2_xxx_EN=1, ASP1/2_MCLK_EN=0, DMIC1_SCL_EN=1 */
+	{ CS8409_PIN_VENDOR_WIDGET, CS8409_PAD_CFG_SLW_RATE_CTRL, 0xfc01 },
+	/* BUS_IDLE=10, +GPIO_I2C */
+	{ CS8409_PIN_VENDOR_WIDGET, CS8409_DEV_CFG3, 0x0280 },
+	/* ASP1_EN=1, ASP2_EN=1 */
+	{ CS8409_PIN_VENDOR_WIDGET, CS8409_DEV_CFG2, 0x0260 },
+	{} /* Terminator */
+};
+
+/* Written to each of the four amps after its TDM slot, before it is powered up */
+const struct cs8409_i2c_param mbp131_ssm3515_init_reg_seq[] = {
+	{ SSM3515_GEC, 0x11 },		/* low EMI edge rate, 12.6 V full scale */
+	{ SSM3515_DAC_VOL, MBP131_SPK_VOL_REG_MAX },	/* -3 dB */
+	{ SSM3515_SAI1, 0x51 },		/* TDM, 32 bit clocks per slot */
+	{ SSM3515_DAC, 0x32 },		/* 32 to 48 kHz, high-pass on, unmuted */
+};
+
+const unsigned int mbp131_ssm3515_init_reg_seq_num = ARRAY_SIZE(mbp131_ssm3515_init_reg_seq);
+
+/*
+ * The CS42L42 sequence with the serial port and sample rate converter settings
+ * AppleHDA uses for 44.1 kHz. The master clock is the bit clock of ASP2 itself
+ * (MCLK_SRC_SEL 0), so the PLL AppleHDA also programs is not used. The chip is
+ * left on its oscillator, the blocks powered down and the serial port channels
+ * disabled: that is done around each stream, see mbp131_cs42l83_stream().
+ */
+static const struct cs8409_i2c_param mbp131_cs42l83_init_reg_seq[] = {
+	{ CS42L42_I2C_TIMEOUT, 0xB0 },
+	{ CS42L42_ADC_CTL, 0x00 },
+	{ 0x1D02, 0x06 },
+	{ CS42L42_ADC_VOLUME, 0x9F },
+	{ CS42L42_SRC_CTL, 0x10 },
+	{ CS42L42_MCLK_CTL, 0x02 },
+	{ CS42L42_FSYNC_P_LOWER, 0xFF },
+	{ CS42L42_FSYNC_P_UPPER, 0x00 },
+	{ CS42L42_MCLK_SRC_SEL, 0x00 },
+	{ CS42L42_ASP_FRM_CFG, 0x02 },
+	{ CS42L42_ASP_CLK_CFG, 0x20 },
+	{ CS42L42_OSC_SWITCH, 0x00 },
+	{ CS42L42_SP_TX_ISOC_CTL, 0x05 },
+	{ CS42L42_SP_RX_ISOC_CTL, 0x05 },
+	{ CS42L42_SP_RX_FS, 0x8A },
+	{ CS42L42_SP_TX_FS, 0xCA },
+	{ CS42L42_SRC_SDIN_FS, 0x4A },
+	{ CS42L42_SRC_SDOUT_FS, 0x4A },
+	{ CS42L42_IN_ASRC_CLK, 0x00 },
+	{ CS42L42_OUT_ASRC_CLK, 0x00 },
+	{ CS42L42_FS_RATE_EN, 0x03 },
+	{ CS42L42_SLOW_START_ENABLE, 0x00 },
+	{ CS42L42_ASP_RX_DAI0_CH1_AP_RES, 0x02 },
+	{ CS42L42_ASP_RX_DAI0_CH1_BIT_MSB, 0x00 },
+	{ CS42L42_ASP_RX_DAI0_CH1_BIT_LSB, 0x00 },
+	{ CS42L42_ASP_RX_DAI0_CH2_AP_RES, 0x02 },
+	{ CS42L42_ASP_RX_DAI0_CH2_BIT_MSB, 0x00 },
+	{ CS42L42_ASP_RX_DAI0_CH2_BIT_LSB, 0x20 },
+	{ CS42L42_ASP_RX_DAI0_EN, 0x00 },
+	{ CS42L42_ASP_TX_CH_EN, 0x00 },
+	{ CS42L42_ASP_TX_CH_AP_RES, 0x0A },
+	{ CS42L42_ASP_TX_CH1_BIT_MSB, 0x00 },
+	{ CS42L42_ASP_TX_CH1_BIT_LSB, 0x00 },
+	{ CS42L42_ASP_TX_CH2_BIT_MSB, 0x00 },
+	{ CS42L42_ASP_TX_CH2_BIT_LSB, 0x20 },
+	{ CS42L42_ASP_TX_SZ_EN, 0x00 },
+	{ CS42L42_PWR_CTL1, 0xFE },
+	{ CS42L42_PWR_CTL2, 0x84 },
+	{ CS42L42_MIXER_CHA_VOL, 0x3F },
+	{ CS42L42_MIXER_CHB_VOL, 0x3F },
+	{ CS42L42_MIXER_ADC_VOL, 0x3f },
+	{ CS42L42_HP_CTL, 0x0D },
+	{ CS42L42_MIC_DET_CTL1, 0xB6 },
+	{ CS42L42_TIPSENSE_CTL, 0xC2 },
+	{ CS42L42_HS_CLAMP_DISABLE, 0x01 },
+	{ CS42L42_HS_SWITCH_CTL, 0xF3 },
