+	/* tip sense inverted, 1 s rise debounce: detect the type of a seated plug */
+	{ CS42L42_TSENSE_CTL, 0x85 },
+	{ CS42L42_HS_BIAS_CTL, 0xC0 },
+	{ CS42L42_PWR_CTL1, 0xFE, 10000 },
+	{ CS42L42_ADC_OVFL_INT_MASK, 0xff },
+	{ CS42L42_MIXER_INT_MASK, 0xff },
