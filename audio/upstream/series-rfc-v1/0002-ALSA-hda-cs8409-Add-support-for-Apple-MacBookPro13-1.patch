+/*
+ * MacBookPro13,1: the CS42L83 is on its PLL and the bit clock only while a
+ * stream is up, see mbp131_cs42l83_stream().
+ */
+static void mbp131_cs42l83_clk_stop(struct sub_codec *cs42l83)
+{
+	struct cs8409_spec *spec = cs42l83->codec->spec;
+
+	if (!spec->scodec_clk_on)
+		return;
+
+	/* the bit clock has to be there still for this switch */
+	cs8409_i2c_write(cs42l83, CS42L42_OSC_SWITCH, 0x00);
+	usleep_range(150, 300);
+	cs8409_i2c_write(cs42l83, CS42L42_PLL_CTL1, 0x00);
+	spec->scodec_clk_on = 0;
+}
+
+/*
+ * Runtime suspend for a board that has nothing but the CS42L42's tip sense to
+ * notice a plug: leave it out of reset, silent and powered down except for the
+ * detection logic, on its own oscillator because the bit clock stops. Its
+ * interrupt comes through as an unsolicited response of the CS8409, the handler
+ * asks for a resume, and the resume looks at the tip sense.
+ */
+static void cs42l42_standby(struct sub_codec *cs42l42)
+{
+	static const struct cs8409_i2c_param cs42l42_standby_seq[] = {
+		{ CS42L42_MIXER_CHA_VOL, 0x3F },
+		{ CS42L42_MIXER_ADC_VOL, 0x3F },
+		{ CS42L42_MIXER_CHB_VOL, 0x3F },
+		{ CS42L42_HP_CTL, 0x0D },
+		{ CS42L42_ASP_RX_DAI0_EN, 0x00 },
+		{ CS42L42_OSC_SWITCH, 0x00 },
+		{ CS42L42_PWR_CTL1, 0xFE },
+	};
+	bool tip;
+
+	cs8409_i2c_bulk_write(cs42l42, cs42l42_standby_seq, ARRAY_SIZE(cs42l42_standby_seq));
+
+	/*
+	 * The tip/ring sense interrupt used while running needs the clocked
+	 * part of the codec. The detect block on page 0x1b keeps working on its
+	 * own, so arm its tip sense interrupt for the opposite of the present
+	 * level. The status is cleared by reading.
+	 */
+	cs8409_i2c_read(cs42l42, CS42L83_DET_INT_STATUS1);
+	tip = cs8409_i2c_read(cs42l42, CS42L42_DET_STATUS1) & CS42L42_TIP_SENSE_MASK;
+	cs8409_i2c_write(cs42l42, CS42L42_DET_INT1_MASK, CS42L42_HSBIAS_SENSE_MASK |
+			 (tip ? CS42L42_TIP_SENSE_PLUG_MASK : CS42L42_TIP_SENSE_UNPLUG_MASK));
+
+	/* the jack state stays: the chip is alive and reports any change */
+	cs42l42->suspended = 1;
+	cs42l42->last_page = 0;
+}
+
 static void cs8409_remove(struct hda_codec *codec)
 {
 	struct cs8409_spec *spec = codec->spec;
 
+	if (codec->fixup_id == CS8409_MBP131)
+		cancel_delayed_work_sync(&spec->irq_sync_work);
+
 	/* Cancel i2c clock disable timer, and disable clock if left enabled */
 	cancel_delayed_work_sync(&spec->i2c_clk_work);
 	cs8409_disable_i2c_clock(codec);
@@ -1015,13 +1076,33 @@ static int cs8409_cs42l42_suspend(struct hda_codec *codec)
 {
 	struct cs8409_spec *spec = codec->spec;
 	int i;
+	/* power_state is only something else than ON for a system sleep */
