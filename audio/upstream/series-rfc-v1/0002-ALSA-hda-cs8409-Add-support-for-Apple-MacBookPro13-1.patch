+/* Apple MacBookPro13,1: CS8409 with a CS42L83 and four SSM3515 speaker amps */
+#define MBP131_NUM_AMPS			4
+/* Where the CS42L83 keeps the status that goes with CS42L42_DET_INT1_MASK */
+#define CS42L83_DET_INT_STATUS1		(CS42L42_PAGE_1B + 0x7B)
+#define MBP131_CS42L83_INT		BIT(0)
+#define MBP131_CS42L83_RESET		BIT(1)
+
+/* The reverse of the Dell boards: amps on ASP1, CS42L83 on ASP2 */
+#define MBP131_SPK_A_PIN_NID		CS8409_PIN_ASP1_TRANSMITTER_A
+#define MBP131_SPK_B_PIN_NID		CS8409_PIN_ASP1_TRANSMITTER_B
+#define MBP131_HP_PIN_NID		CS8409_PIN_ASP2_TRANSMITTER_A
+#define MBP131_AMIC_PIN_NID		CS8409_PIN_ASP2_RECEIVER_A
+#define MBP131_DMIC_PIN_NID		CS8409_PIN_DMIC1_IN
+#define MBP131_DMIC_ADC_PIN_NID		CS8409_PIN_DMIC1
+
+#define SSM3515_I2C_ADDR(n)		((0x14 + (n)) << 1)
+#define SSM3515_PWR			0x00
+#define SSM3515_PWR_SPWDN		BIT(0)
+#define SSM3515_PWR_S_RST		BIT(1)
+#define SSM3515_PWR_APWDN_EN		BIT(7)
+#define SSM3515_GEC			0x01
+#define SSM3515_DAC			0x02
+#define SSM3515_DAC_VOL			0x03
+#define SSM3515_DAC_VOL_MUTE		0xFF
+/* 0.375 dB a step down from +24 dB at 0x00; 0x48, -3 dB, is what AppleHDA sets */
+#define MBP131_SPK_VOL_REG_MAX		0x48
+#define MBP131_SPK_VOL_MAX		(SSM3515_DAC_VOL_MUTE - MBP131_SPK_VOL_REG_MAX)
