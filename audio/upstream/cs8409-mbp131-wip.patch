+/*
+ * In D3 the function group does not pass on the GPIO unsolicited response,
+ * and a wake over a stopped link does not reach this machine's controller
+ * either. So over runtime suspend the MacBook keeps the function group in D0
+ * and powers down the widgets only: the CS42L83's interrupt is then delivered
+ * as while running, and the handler asks for a resume.
+ */
+static void cs8409_set_power_state(struct hda_codec *codec, hda_nid_t fg,
+				   unsigned int power_state)
+{
+	bool keep_fg = power_state == AC_PWRST_D3 &&
+		       codec->fixup_id == CS8409_MBP131 &&
+		       codec->core.dev.power.power_state.event == PM_EVENT_ON;
+
+	if (!keep_fg)
+		snd_hda_codec_write(codec, fg, 0, AC_VERB_SET_POWER_STATE, power_state);
+	snd_hda_codec_set_power_to_all(codec, fg, power_state);
+}
